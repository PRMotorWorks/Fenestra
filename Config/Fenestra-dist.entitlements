<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (needed for notarization) blocks Apple events unless this is set: Fenestra uses them
	     for Restart / Shut down fallbacks (System Events) and the one-time Battery saver permission prompt. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
